datasets/
data/raw/
data/processed/

# Experiment tracking
mlruns/
mlartifacts/
wandb/
tensorboard_logs/
runs/

# LangSmith traces
.langsmith/
langsmith_traces/

# ============================================
# ✅ WHITELIST - Always Include These
# ============================================
# Keep folder structure with .gitkeep files
!**/.gitkeep

# Keep all source code
!*.py
!*.ipynb

# Keep requirements
!requirements.txt

# Keep documentation
!README.md
!*.md

# Keep prompt templates
!prompts/*.txt
!qna/*.txt

# ============================================
# 📁 Folder Structure Preservation
# ============================================
# These ensure empty directories are tracked
# Run these commands to create .gitkeep files:
#   touch task-4/chroma_db/.gitkeep
#   touch task-4/uploaded_documents/.gitkeep