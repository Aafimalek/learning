# ============================================
# 🤖 GenAI & Agentic AI Learning Repository
# .gitignore - Customized for this project
# ============================================

# ============================================
# 🔐 SENSITIVE DATA - API Keys & Secrets
# ============================================
.env
.env.*
.env.local
.env.production
*.env
.envrc
secrets.json
secrets.yaml
secrets.yml
*_secret*
api_keys.txt
credentials.json

# ============================================
# 🐍 Python Cache & Bytecode
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# 📓 Jupyter Notebook
# ============================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/
profile_default/
ipython_config.py

# ============================================
# 🗄️ Database Files (LangGraph Checkpoints)
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
checkpoints.db*

# ============================================
# 📊 Vector Databases - ChromaDB
# ============================================
# Ignore ChromaDB data files but keep folder structure
task-4/chroma_db/*.sqlite3
task-4/chroma_db/**/data_level0.bin
task-4/chroma_db/**/header.bin
task-4/chroma_db/**/index_metadata.pickle
task-4/chroma_db/**/length.bin
task-4/chroma_db/**/link_lists.bin

# ============================================
# 📄 Uploaded Documents & Generated Metadata
# ============================================
# Ignore uploaded PDFs (user-specific data)
task-4/uploaded_documents/*/
task-4/uploaded_documents/**/*.pdf

# Generated metadata files
task-4/document_hashes.json
task-4/chroma_metadata.json

